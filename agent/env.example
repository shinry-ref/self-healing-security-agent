# エージェント（FastAPI）の環境変数。実運用では .env にコピーして使う。

# 安全装置：診断してよい相手（やられ役サイト）を完全一致で列挙。カンマ区切り。
# ここに無いURLへの診断要求は 403 で弾く。これがツールの合法性の要。
ALLOWED_TARGETS=http://localhost:3001

# やられ役サイトの制御エンドポイント（reset/patch/state）の共有シークレット。
# target 側の CONTROL_TOKEN と必ず一致させる。
CONTROL_TOKEN=antibody-dev-control

# Gemini（原因特定・修正コード生成の頭脳）。未設定でも実コード対応の
# フォールバック差分で自己修復ループは完結する。
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 1 のとき照合で NVD API も参照する（デモは自前データ中心なので任意）。
# ENABLE_NVD=0

# 修正の適用方式：
#   未設定（既定）= flag … やられ役サイトのランタイム状態を control/patch で切替
#                           （agent↔target は HTTP だけ。分離した Cloud Run でも動く）
#   file          … agent がリポジトリの実ソースを直接書き換えて直す（HMRで反映）
#                   現実の「診断側がコードを修正する」流れに近い。TARGET_REPO が必須で、
#                   agent と target のソースが同じ場所にあること（＝ローカル／モノレポ）。
# FIX_MODE=file
# TARGET_REPO=/abs/path/to/target
