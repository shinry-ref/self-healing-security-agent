# やられ役サイト（NEKO MART）の環境変数サンプル
# 使うときは `cp env.example .env.local` して値を調整してください。

# 制御エンドポイント（脆弱性のリセット／修正適用）の共有シークレット。
# エージェント側の TARGET_CONTROL_TOKEN と一致させること。
CONTROL_TOKEN=mamori-dev-control

# セッショントークンの署名鍵（安全版トークンで使用）
SESSION_SIGNING_KEY=mamori-demo-signing-key-change-me

# PORT は Cloud Run が自動注入。ローカルでは package.json の -p 3001 を使用。
